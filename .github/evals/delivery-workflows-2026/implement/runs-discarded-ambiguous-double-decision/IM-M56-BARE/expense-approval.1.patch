+from threading import RLock
+
+
 class Repository:
     def __init__(self):
         self.expenses = {}
         self.idempotency = {}
         self.audit = []
+        # The service performs read/check/write sequences. Keep those sequences
+        # atomic so concurrent retries cannot create duplicate records.
+        self.lock = RLock()
