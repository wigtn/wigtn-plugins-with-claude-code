 from .repository import Repository
+from .domain import Expense
 
 class ExpenseService:
     def __init__(self, repository: Repository):
         self.repository = repository
 
     def submit(self, owner_id, team_id, amount, idempotency_key):
-        raise NotImplementedError
+        if amount <= 0:
+            raise ValueError("amount must be positive")
+
+        idempotency_scope = (owner_id, idempotency_key)
+        payload = (team_id, amount)
+        existing = self.repository.idempotency.get(idempotency_scope)
+        if existing is not None:
+            if existing["payload"] != payload:
+                raise ValueError("idempotency key payload mismatch")
+            return self.repository.expenses[existing["expense_id"]]
+
+        expense_id = str(len(self.repository.expenses) + 1)
+        expense = Expense(
+            id=expense_id,
+            owner_id=owner_id,
+            team_id=team_id,
+            amount=amount,
+            status="PENDING",
+        )
+        self.repository.expenses[expense_id] = expense
+        self.repository.idempotency[idempotency_scope] = {
+            "payload": payload,
+            "expense_id": expense_id,
+        }
+        self.repository.audit.append({
+            "actor": owner_id,
+            "action": "SUBMIT",
+            "before": None,
+            "after": "PENDING",
+        })
+        return expense
 
     def decide(self, actor_id, actor_team, expense_id, action, reason=None):
-        raise NotImplementedError
+        expense = self.repository.expenses[expense_id]
+        if actor_team != expense.team_id or not self._is_manager(actor_id):
+            raise PermissionError("only a manager from the same team can decide")
+        if actor_id == expense.owner_id:
+            raise PermissionError("owners cannot decide their own expenses")
+        if expense.status != "PENDING":
+            raise ValueError("expense has already been decided")
+
+        normalized_action = self._normalize_decision(action)
+        if normalized_action == "REJECTED" and (reason is None or not reason.strip()):
+            raise ValueError("rejected expenses require a reason")
+
+        before = expense.status
+        expense.status = normalized_action
+        expense.reason = reason if normalized_action == "REJECTED" else None
+        self.repository.audit.append({
+            "actor": actor_id,
+            "action": normalized_action,
+            "before": before,
+            "after": expense.status,
+        })
+        return expense
+
+    def _normalize_decision(self, action):
+        if action == "APPROVE":
+            return "APPROVED"
+        if action == "REJECT":
+            return "REJECTED"
+        if action in {"APPROVED", "REJECTED"}:
+            return action
+        raise ValueError("unknown decision action")
