+from functools import cmp_to_key
+
 from .cursor import encode_cursor, decode_cursor
 
+
+def _validate_limit(limit):
+    if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 50:
+        raise ValueError("limit must be an integer from 1 to 50")
+
+
+def _is_after_cursor(record, cursor_key):
+    if cursor_key is None:
+        return True
+
+    created_at, record_id = cursor_key
+    if record["created_at"] != created_at:
+        return record["created_at"] < created_at
+    return record["id"] > record_id
+
+
+def _compare_records(left, right):
+    if left["created_at"] != right["created_at"]:
+        return -1 if left["created_at"] > right["created_at"] else 1
+    if left["id"] == right["id"]:
+        return 0
+    return -1 if left["id"] < right["id"] else 1
+
+
 def search(records, tenant_id, query, limit, cursor=None):
-    raise NotImplementedError
+    _validate_limit(limit)
+    cursor_key = decode_cursor(cursor, tenant_id) if cursor is not None else None
+    folded_query = query.casefold()
+
+    matches = [
+        record
+        for record in records
+        if record.get("tenant_id") == tenant_id
+        and folded_query in record.get("name", "").casefold()
+        and _is_after_cursor(record, cursor_key)
+    ]
+    ordered = sorted(matches, key=cmp_to_key(_compare_records))
+
+    page = ordered[:limit]
+    if len(ordered) <= limit:
+        return page, None
+
+    last = page[-1]
+    next_cursor = encode_cursor(tenant_id, last["created_at"], last["id"])
+    return page, next_cursor
