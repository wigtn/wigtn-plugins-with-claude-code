+import base64
+import hashlib
+import hmac
+import json
+
+
+_CURSOR_SECRET = b"tenant-search-cursor-v1"
+
+
+def _urlsafe_b64encode(value: bytes) -> str:
+    return base64.urlsafe_b64encode(value).decode("ascii").rstrip("=")
+
+
+def _urlsafe_b64decode(value: str) -> bytes:
+    padding = "=" * (-len(value) % 4)
+    return base64.urlsafe_b64decode((value + padding).encode("ascii"))
+
+
+def _sign(payload: bytes) -> str:
+    signature = hmac.new(_CURSOR_SECRET, payload, hashlib.sha256).digest()
+    return _urlsafe_b64encode(signature)
+
+
 def encode_cursor(tenant_id: str, created_at: int, record_id: str) -> str:
-    raise NotImplementedError
+    payload = json.dumps(
+        {"tenant_id": tenant_id, "created_at": created_at, "id": record_id},
+        sort_keys=True,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    encoded_payload = _urlsafe_b64encode(payload)
+    return f"{encoded_payload}.{_sign(payload)}"
+
 
 def decode_cursor(value: str, tenant_id: str):
-    raise NotImplementedError
+    try:
+        encoded_payload, signature = value.split(".", 1)
+        payload = _urlsafe_b64decode(encoded_payload)
+    except Exception as exc:
+        raise ValueError("invalid cursor") from exc
+
+    if not hmac.compare_digest(signature, _sign(payload)):
+        raise ValueError("invalid cursor")
+
+    try:
+        data = json.loads(payload.decode("utf-8"))
+        cursor_tenant = data["tenant_id"]
+        created_at = data["created_at"]
+        record_id = data["id"]
+    except Exception as exc:
+        raise ValueError("invalid cursor") from exc
+
+    if cursor_tenant != tenant_id:
+        raise ValueError("invalid cursor")
+
+    return created_at, record_id
