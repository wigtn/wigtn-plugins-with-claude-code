+from dataclasses import asdict
+
+from .domain import Expense
 from .repository import Repository
 
 class ExpenseService:
@@ -5,7 +8,76 @@ class ExpenseService:
         self.repository = repository
 
     def submit(self, owner_id, team_id, amount, idempotency_key):
-        raise NotImplementedError
+        if amount <= 0:
+            raise ValueError("amount must be positive")
+
+        payload = (team_id, amount)
+        idempotency_scope = (owner_id, idempotency_key)
+        existing = self.repository.idempotency.get(idempotency_scope)
+        if existing is not None:
+            existing_payload, expense_id = existing
+            if existing_payload != payload:
+                raise ValueError("idempotency key reused with different payload")
+            return self.repository.expenses[expense_id]
+
+        expense_id = f"exp_{len(self.repository.expenses) + 1}"
+        expense = Expense(
+            id=expense_id,
+            owner_id=owner_id,
+            team_id=team_id,
+            amount=amount,
+            status="PENDING",
+        )
+        self.repository.expenses[expense_id] = expense
+        self.repository.idempotency[idempotency_scope] = (payload, expense_id)
+        self._audit(actor_id=owner_id, action="SUBMIT", before=None, after=expense)
+        return expense
 
     def decide(self, actor_id, actor_team, expense_id, action, reason=None):
-        raise NotImplementedError
+        expense = self.repository.expenses[expense_id]
+        target_status = self._target_status(action)
+
+        if not self._is_manager(actor_id):
+            raise PermissionError("only managers may decide expenses")
+        if actor_team != expense.team_id:
+            raise PermissionError("manager must belong to the expense team")
+        if actor_id == expense.owner_id:
+            raise PermissionError("owner cannot decide their own expense")
+        if expense.status != "PENDING":
+            raise ValueError("expense has already been decided")
+        if target_status == "REJECTED" and not (reason and reason.strip()):
+            raise ValueError("rejection reason is required")
+
+        before = self._snapshot(expense)
+        expense.status = target_status
+        expense.reason = reason.strip() if target_status == "REJECTED" else None
+        self._audit(actor_id=actor_id, action=target_status, before=before, after=expense)
+        return expense
+
+    def _target_status(self, action):
+        normalized = action.upper()
+        if normalized in ("APPROVE", "APPROVED"):
+            return "APPROVED"
+        if normalized in ("REJECT", "REJECTED"):
+            return "REJECTED"
+        raise ValueError("unsupported decision action")
+
+    def _is_manager(self, actor_id):
+        return str(actor_id).startswith("m")
+
+    def _audit(self, actor_id, action, before, after):
+        self.repository.audit.append(
+            {
+                "actor": actor_id,
+                "action": action,
+                "before": before,
+                "after": self._snapshot(after),
+            }
+        )
+
+    def _snapshot(self, expense):
+        if expense is None:
+            return None
+        if isinstance(expense, dict):
+            return dict(expense)
+        return asdict(expense)
