--- a/webhook/signing.py
+++ b/webhook/signing.py
@@ -1,2 +1,20 @@
+import hashlib
+import hmac
+
+
 def verify_signature(secret: bytes, body: bytes, header: str) -> bool:
-    raise NotImplementedError
+    prefix = "sha256="
+    if not isinstance(header, str) or not header.startswith(prefix):
+        return False
+
+    provided = header[len(prefix):]
+    if len(provided) != hashlib.sha256().digest_size * 2:
+        return False
+
+    try:
+        bytes.fromhex(provided)
+    except ValueError:
+        return False
+
+    expected = hmac.new(secret, body, hashlib.sha256).hexdigest()
+    return hmac.compare_digest(provided, expected)
