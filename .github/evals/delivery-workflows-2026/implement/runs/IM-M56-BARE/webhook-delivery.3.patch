diff --git a/webhook/signing.py b/webhook/signing.py
index 2320976..6efb4cb 100644
--- a/webhook/signing.py
+++ b/webhook/signing.py
@@ -1,2 +1,27 @@
+import hashlib
+import hmac
+import string
+
+
+_PREFIX = "sha256="
+_HEX_DIGITS = frozenset(string.hexdigits)
+
+
 def verify_signature(secret: bytes, body: bytes, header: str) -> bool:
-    raise NotImplementedError
+    if not isinstance(header, str) or not header.startswith(_PREFIX):
+        return False
+
+    encoded_signature = header[len(_PREFIX):]
+    if (
+        len(encoded_signature) != hashlib.sha256().digest_size * 2
+        or any(character not in _HEX_DIGITS for character in encoded_signature)
+    ):
+        return False
+
+    try:
+        supplied_signature = bytes.fromhex(encoded_signature)
+    except ValueError:
+        return False
+
+    expected_signature = hmac.digest(secret, body, "sha256")
+    return hmac.compare_digest(expected_signature, supplied_signature)
