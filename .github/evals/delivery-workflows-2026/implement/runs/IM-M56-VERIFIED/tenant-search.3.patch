+import base64
+import binascii
+import hashlib
+import hmac
+import json
+
+
+_CURSOR_VERSION = 1
+_CURSOR_SIGNING_KEY = b"tenant-search-cursor-v1"
+
+
+def _encode_part(value: bytes) -> str:
+    return base64.urlsafe_b64encode(value).rstrip(b"=").decode("ascii")
+
+
+def _decode_part(value: str) -> bytes:
+    padding = "=" * (-len(value) % 4)
+    return base64.b64decode(value + padding, altchars=b"-_", validate=True)
+
+
 def encode_cursor(tenant_id: str, created_at: int, record_id: str) -> str:
-    raise NotImplementedError
+    """Encode the tenant and final sort key into a signed URL-safe cursor."""
+    payload = json.dumps(
+        [_CURSOR_VERSION, tenant_id, created_at, record_id],
+        ensure_ascii=False,
+        separators=(",", ":"),
+    ).encode("utf-8")
+    signature = hmac.new(_CURSOR_SIGNING_KEY, payload, hashlib.sha256).digest()
+    return f"{_encode_part(payload)}.{_encode_part(signature)}"
+
 
 def decode_cursor(value: str, tenant_id: str):
-    raise NotImplementedError
+    """Validate a cursor and return its (created_at, id) sort key."""
+    try:
+        if not isinstance(value, str):
+            raise ValueError
+        payload_part, signature_part = value.split(".")
+        payload = _decode_part(payload_part)
+        signature = _decode_part(signature_part)
+        if (
+            _encode_part(payload) != payload_part
+            or _encode_part(signature) != signature_part
+        ):
+            raise ValueError
+        expected = hmac.new(_CURSOR_SIGNING_KEY, payload, hashlib.sha256).digest()
+        if not hmac.compare_digest(signature, expected):
+            raise ValueError
+
+        decoded = json.loads(payload.decode("utf-8"))
+        if (
+            not isinstance(decoded, list)
+            or len(decoded) != 4
+            or decoded[0] != _CURSOR_VERSION
+            or decoded[1] != tenant_id
+            or isinstance(decoded[2], bool)
+            or not isinstance(decoded[2], int)
+            or not isinstance(decoded[3], str)
+        ):
+            raise ValueError
+        return decoded[2], decoded[3]
+    except (ValueError, TypeError, UnicodeError, binascii.Error, json.JSONDecodeError):
+        raise ValueError("invalid cursor") from None
