 from .cursor import encode_cursor, decode_cursor
 
+
 def search(records, tenant_id, query, limit, cursor=None):
-    raise NotImplementedError
+    """Return one tenant-scoped, case-insensitive, keyset-paginated page."""
+    if isinstance(limit, bool) or not isinstance(limit, int) or not 1 <= limit <= 50:
+        raise ValueError("limit must be an integer between 1 and 50")
+
+    after = decode_cursor(cursor, tenant_id) if cursor is not None else None
+    folded_query = query.casefold()
+
+    matches = [
+        record
+        for record in records
+        if record["tenant_id"] == tenant_id
+        and folded_query in record["name"].casefold()
+        and (
+            after is None
+            or record["created_at"] < after[0]
+            or (
+                record["created_at"] == after[0]
+                and record["id"] > after[1]
+            )
+        )
+    ]
+    matches.sort(key=lambda record: (-record["created_at"], record["id"]))
+
+    page = matches[:limit]
+    if len(matches) <= limit:
+        return page, None
+
+    last = page[-1]
+    return page, encode_cursor(tenant_id, last["created_at"], last["id"])
